{
  "manifest_version": 2,
  "name": "OmaThunder — Omarchy Theme & AI Triage",
  "version": "0.2.8",
  "description": "Live Omarchy theming (chrome, message body, compose) and 3-stage Gemini/Claude/Ollama AI triage with reviewable proposals.",
  "author": "omathunder",
  "browser_specific_settings": {
    "gecko": {
      "id": "omathunder@omathunder.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "theme",
    "nativeMessaging",
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "menus",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["lib/core.js", "lib/standalone.js", "background.js"]
  },
  "browser_action": {
    "default_title": "OmaThunder",
    "default_popup": "ui/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "message_display_action": {
    "default_title": "OmaThunder AI",
    "default_popup": "ui/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "compose_action": {
    "default_title": "OmaThunder AI",
    "default_popup": "ui/compose.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "omaFilters": {
      "schema": "api/filters/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["omaFilters"]],
        "script": "api/filters/implementation.js"
      }
    }
  }
}
