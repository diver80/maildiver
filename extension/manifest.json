{
  "manifest_version": 2,
  "name": "OmaThunder — Bridge & Omarchy Theme",
  "version": "0.3.1",
  "description": "Connects Thunderbird to the OmaThunder app (local bridge for mail, calendar, contacts and filters) and themes Thunderbird with Omarchy colors.",
  "author": "omathunder",
  "browser_specific_settings": {
    "gecko": {
      "id": "omathunder@omathunder.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "theme",
    "nativeMessaging",
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "addressBooks",
    "compose",
    "compose.save",
    "compose.send",
    "tabs"
  ],
  "background": {
    "scripts": [
      "lib/core.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "OmaThunder",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "omaFilters": {
      "schema": "api/filters/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "omaFilters"
          ]
        ],
        "script": "api/filters/implementation.js"
      }
    },
    "omaCalendar": {
      "schema": "api/calendar/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "omaCalendar"
          ]
        ],
        "script": "api/calendar/implementation.js"
      }
    }
  }
}
