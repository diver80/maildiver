{
  "name": "MailDiver",
  "slug": "maildiver",
  "identifier": "dev.maildiver.app",
  "version": "0.7.16",
  "icon": "resources/icon.png",
  "main": "./cmd/maildiver",
  "out": "dist",
  "macos": {
    "minimumSystemVersion": "12.0",
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.productivity",
      "NSUserNotificationAlertStyle": "banner",
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "Email Address",
          "CFBundleURLSchemes": ["mailto"]
        }
      ]
    }
  },
  "linux": {
    "webview": false,
    "categories": [
      "Office",
      "Email"
    ],
    "formats": [
      "deb",
      "rpm",
      "pkgbuild"
    ]
  },
  "android": {
    "minSdk": 26,
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.POST_NOTIFICATIONS"
    ]
  }
}
