[Desktop Entry]
Type=Application
Name=PostDive
GenericName=Email, Calendar & Contacts
Comment=Native IMAP/SMTP email, calendar & contacts client with optional local/cloud AI
Exec=/usr/bin/postdive %u
Icon=postdive
Terminal=false
Categories=Network;Email;Office;Calendar;
MimeType=x-scheme-handler/mailto;
StartupWMClass=postdive
Keywords=email;mail;imap;smtp;calendar;contacts;pgp;smime;ai;
